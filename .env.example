# Lokalnie: skopiuj do .env.local (plik nie trafia do repozytorium) i uruchom `vercel dev`.
# Na Vercelu zmienne SUPABASE_* / NEXT_PUBLIC_SUPABASE_* / POSTGRES_* dodaje integracja Supabase.

# Supabase – frontend (logowanie)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase – serwer (API, pełny dostęp; nigdy nie udostępniaj w przeglądarce)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bezpośrednie połączenie z bazą – migracja schematu w buildzie (scripts/migrate.mjs)
POSTGRES_URL_NON_POOLING=

# Claude API
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_FALLBACKS=off

# Adresy e-mail administratorów (po przecinku) – dostają rolę admin przy logowaniu
ADMIN_EMAILS=

# Konta, zaproszenia i reset hasła obsługuje centrum aplikacji (nutri_hub), więc RESEND_API_KEY, MAIL_FROM i APP_URL nie są tu potrzebne.

# Błędy (Sentry): ten sam DSN w obu zmiennych, w Production i Preview; bez nich nic nie jest wysyłane
# SENTRY_DSN=
# VITE_SENTRY_DSN=
