# Lokalnie: skopiuj do .env.local (plik nie trafia do repozytorium) i uruchom `vercel dev`.
# Na Vercelu zmienne SUPABASE_* / NEXT_PUBLIC_SUPABASE_* / POSTGRES_* dodaje integracja Supabase.

# Supabase – frontend (logowanie)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase – serwer (API, pełny dostęp; nigdy nie udostępniaj w przeglądarce)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bezpośrednie połączenie z bazą – migracja schematu w buildzie (scripts/migrate.mjs)
POSTGRES_URL_NON_POOLING=

# Claude API
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_FALLBACKS=off

# Adresy e-mail administratorów (po przecinku) – dostają rolę admin przy logowaniu
ADMIN_EMAILS=

# Adres aplikacji w linkach z e-maili (zaproszenia, reset hasła), np. https://nutridocumentation-nxdi.vercel.app
APP_URL=

# Wysyłka zaproszeń i linków resetu hasła (Resend, https://resend.com)
RESEND_API_KEY=
# MAIL_FROM=Nutri APEX <no-reply@nutripartners.co>
